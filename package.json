{
  "name": "mera-store",
  "version": "1.0.0",
  "private": true,
  "description": "Mera Store full MERN e-commerce capstone implementation.",
  "scripts": {
    "dev": "concurrently \"nodemon server/server.js\" \"vite --config client/vite.config.js --host 0.0.0.0 --port 5173\"",
    "server": "node server/server.js",
    "client": "vite --config client/vite.config.js --host 0.0.0.0 --port 5173",
    "start": "node server/server.js",
    "seed": "node server/seed.js",
    "build": "vite build --config client/vite.config.js"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.9.0",
    "@stripe/stripe-js": "^7.8.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "stripe": "^18.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "vite": "^7.1.3"
  }
}
